[
    {
        "ConversationTopicId": "1427_0104_TalkTo_CultMother",
        "PlayerPrompt": "\"She lived, but chose to join them.\"",
        "NPCResponse": "It is as I feared. I have already asked so much of you… but could you stay with her? Convince them you intend to join as well?",
        "AchievementUnlock": "",
        "RequiredAchievement": "",
